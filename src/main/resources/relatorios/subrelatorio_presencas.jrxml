<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subrelatorio_presencas"
              pageWidth="535"
              pageHeight="200"
              columnWidth="535"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="33333333-3333-3333-3333-333333333333">

    <field name="dataHora" class="java.lang.String"/>
    <field name="aluno" class="java.lang.String"/>
    <field name="situacao" class="java.lang.String"/>

    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="24" backcolor="#E5E7EB"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="8" y="5" width="120" height="16"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Data/Hora]]></text>
            </staticText>

            <staticText>
                <reportElement x="135" y="5" width="280" height="16"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Aluno]]></text>
            </staticText>

            <staticText>
                <reportElement x="420" y="5" width="100" height="16"/>
                <textElement textAlignment="Right">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Situação]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28">
            <line>
                <reportElement x="0" y="26" width="535" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.25" lineColor="#D1D5DB"/>
                </graphicElement>
            </line>

            <textField textAdjust="ScaleFont">
                <reportElement x="8" y="5" width="120" height="16"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dataHora}]]></textFieldExpression>
            </textField>

            <textField textAdjust="ScaleFont">
                <reportElement x="135" y="5" width="280" height="16"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{aluno}]]></textFieldExpression>
            </textField>

            <textField textAdjust="ScaleFont">
                <reportElement x="420" y="5" width="100" height="16"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{situacao}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>