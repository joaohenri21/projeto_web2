<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="relatorio_turmas"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20"
    uuid="11111111-1111-1111-1111-111111111111">

    <parameter name="SUBRELATORIO_PRESENCAS" class="net.sf.jasperreports.engine.JasperReport" />

    <field name="nome" class="java.lang.String" />
    <field name="modalidade" class="java.lang.String" />
    <field name="diaSemana" class="java.lang.String" />
    <field name="horario" class="java.lang.String" />
    <field name="professor" class="java.lang.String" />
    <field name="presencas" class="java.util.List" />

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="555" height="35" />
                <textElement textAlignment="Center">
                    <font size="20" isBold="true" />
                </textElement>
                <text><![CDATA[Relatório da Turma - Presenças]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="38" width="555" height="20" />
                <textElement textAlignment="Center">
                    <font size="11" />
                </textElement>
                <text><![CDATA[Centro de Treinamento CT JW]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="170" splitType="Stretch">

            <rectangle>
                <reportElement x="0" y="0" width="555" height="90" />
            </rectangle>

            <staticText>
                <reportElement x="10" y="10" width="70" height="20" />
                <textElement>
                    <font isBold="true" />
                </textElement>
                <text><![CDATA[Turma:]]></text>
            </staticText>

            <textField>
                <reportElement x="80" y="10" width="450" height="20" />
                <textFieldExpression><![CDATA[$F{nome}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="10" y="35" width="90" height="20" />
                <textElement>
                    <font isBold="true" />
                </textElement>
                <text><![CDATA[Modalidade:]]></text>
            </staticText>

            <textField>
                <reportElement x="100" y="35" width="180" height="20" />
                <textFieldExpression><![CDATA[$F{modalidade}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="300" y="35" width="40" height="20" />
                <textElement>
                    <font isBold="true" />
                </textElement>
                <text><![CDATA[Dia:]]></text>
            </staticText>

            <textField>
                <reportElement x="340" y="35" width="190" height="20" />
                <textFieldExpression><![CDATA[$F{diaSemana}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="10" y="60" width="70" height="20" />
                <textElement>
                    <font isBold="true" />
                </textElement>
                <text><![CDATA[Horário:]]></text>
            </staticText>

            <textField>
                <reportElement x="80" y="60" width="200" height="20" />
                <textFieldExpression><![CDATA[$F{horario}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="300" y="60" width="80" height="20" />
                <textElement>
                    <font isBold="true" />
                </textElement>
                <text><![CDATA[Professor:]]></text>
            </staticText>

            <textField>
                <reportElement x="380" y="60" width="150" height="20" />
                <textFieldExpression><![CDATA[$F{professor}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="10" y="105" width="200" height="20" />
                <textElement>
                    <font isBold="true" />
                </textElement>
                <text><![CDATA[Presenças registradas:]]></text>
            </staticText>

            <subreport>
                <reportElement x="10" y="130" width="535" height="40" />
                <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{presencas})]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{SUBRELATORIO_PRESENCAS}]]></subreportExpression>
            </subreport>

        </band>
    </detail>

</jasperReport>